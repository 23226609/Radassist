# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git. Never put real values in this example file.

# --- Server ---------------------------------------------------------------
PORT=5002
NODE_ENV=development

# Browser origins that may call the API from another origin, comma-separated.
# Leave it out to allow only the local dev servers (localhost:5173, 5174, 3000).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB (Azure Cosmos DB for MongoDB, or any MongoDB) ----------------
MONGODB_URI=CHANGE_ME
MONGODB_DB=radassist

# --- Login tokens ---------------------------------------------------------
# A long random string. Anyone who knows it can sign in as anyone.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h

# --- CURV report service (middleware.py) ----------------------------------
AI_BASE_URL=http://localhost:8001

# --- Azure OpenAI: places the film boxes (optional) -----------------------
# Leave blank and the app runs without film boxes.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Demo account passwords (npm run seed, npm run reset-demo-passwords) ---
# Choose your own, at least 6 characters each. The scripts stop with a message
# if one is missing or still says CHANGE_ME.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_TECH_PASSWORD=CHANGE_ME
SEED_PRIYA_PASSWORD=CHANGE_ME
SEED_MARCUS_PASSWORD=CHANGE_ME
SEED_DOCTOR_PASSWORD=CHANGE_ME

# --- Optional: booking room settings (defaults shown) ---------------------
# BOOKING_UTC_OFFSET=+08:00
# XRAY_SLOT_CAPACITY=2
# XRAY_DAILY_QUOTA=20
