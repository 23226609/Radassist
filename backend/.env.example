# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git. Never put real values in this example file.

# --- Server ---------------------------------------------------------------
PORT=5002
NODE_ENV=development

# Browser origins that may call the API from another origin, comma-separated.
# Leave it out to allow only the local dev servers (localhost:5173, 5174, 3000).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB (Azure Cosmos DB for MongoDB, or any MongoDB) ----------------
MONGODB_URI=CHANGE_ME
MONGODB_DB=radassist

# --- Login tokens ---------------------------------------------------------
# A long random string. Anyone who knows it can sign in as anyone.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h

# --- CURV report service (middleware.py) ----------------------------------
AI_BASE_URL=http://localhost:8001

# --- Azure OpenAI: places the film boxes (optional) -----------------------
# Leave blank and the app runs without film boxes.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Reasoning agent (POST /api/cases/:id/agent) ----------------------------
# search_similar_cases: the name of your text-embedding-3-small deployment.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional: cut-off for "similar enough", between 0 and 1 (default 0.5).
AGENT_SIMILARITY_MIN=
# search_guideline: optional NCBI settings for a higher rate limit. NICE and
# Radiopaedia use the Azure OpenAI settings above (its web_search tool).
# AZURE_OPENAI_WEBSEARCH_DEPLOYMENT=   (only if your main deployment cannot web-search)
NCBI_API_KEY=
NCBI_EMAIL=
# notify: Azure Communication Services email, resource radassist-acs (Keys > connection string).
# Email is only sent for a report endorsed AFTER the server first starts with this set;
# earlier endorsements are never caught up.
ACS_CONNECTION_STRING=
# Optional. Defaults to DoNotReply@bea841cf-6a1c-4660-8978-566871702bb6.azurecomm.net
ACS_SENDER_ADDRESS=

# --- Demo account passwords (npm run seed, npm run reset-demo-passwords) ---
# Choose your own, at least 6 characters each. The scripts stop with a message
# if one is missing or still says CHANGE_ME.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_TECH_PASSWORD=CHANGE_ME
SEED_PRIYA_PASSWORD=CHANGE_ME
SEED_MARCUS_PASSWORD=CHANGE_ME
SEED_DOCTOR_PASSWORD=CHANGE_ME
SEED_PATIENT_PASSWORD=CHANGE_ME

# --- Optional: booking room settings (defaults shown) ---------------------
# BOOKING_UTC_OFFSET=+08:00
# XRAY_SLOT_CAPACITY=2
# XRAY_DAILY_QUOTA=20
